name: Build Kernel - ZyC Clang 15.0.7 (2026-02-05)

on:
  workflow_dispatch:
  push:
    branches: [zycromerz]

env:
  KERNEL_NAME: "xcalibur-v5.4-violet-dynamic"
  KERNEL_VARIANT: "Retrofit Dynamic"
  KERNEL_SUPPORT: "Android 15.0-16.0"
  CONFIG_FILE: "vendor/violet-perf_defconfig"
  ARCH: "arm64"
  KBUILD_BUILD_HOST: "SuperiorOS"
  KBUILD_BUILD_USER: "Redhawk"
  ANYKERNEL_REPO: "https://github.com/Joker-V2/AnyKernel3"
  ANYKERNEL_BRANCH: "sixteen"
  CLANG_URL: "https://github.com/ZyCromerZ/Clang/releases/download/15.0.7-20260205-release/Clang-15.0.7-20260205.tar.gz"
  ZIPSIGNER_URL: "https://github.com/Magisk-Modules-Repo/zipsigner/raw/master/bin/zipsigner-3.0-dexed.jar"

jobs:
  build:
    runs-on: ubuntu-24.04
    
    steps:
    - name: 📥 Checkout Kernel Source
      uses: actions/checkout@v4
      with:
        ref: zycromerz
        fetch-depth: 1
    
    - name: ⚙️ Setup Build Environment
      run: |
        sudo apt update
        sudo apt install -y \
          bc bison flex \
          build-essential \
          libssl-dev libelf-dev libncurses-dev \
          gcc-aarch64-linux-gnu \
          gcc-arm-linux-gnueabi \
          zip unzip curl wget git \
          python3 \
          openjdk-17-jre-headless \
          ccache \
          zstd \
          binutils-aarch64-linux-gnu \
          device-tree-compiler \
          lz4 xz-utils zlib1g-dev \
          openjdk-17-jdk \
          python-is-python3 \
          p7zip-full \
          android-sdk-libsparse-utils \
          erofs-utils \
          gnupg \
          gperf \
          libx11-dev \
          libreadline-dev \
          libgl1 libgl1-mesa-dev \
          python3-markdown \
          libxml2-utils xsltproc \
          libtinfo6 \
          cpio kmod openssl pahole \
          libarchive-tools rsync \
          util-linux 
        
        # Set up environment variables
        echo "KERNEL_DIR=$(pwd)" >> $GITHUB_ENV
        echo "OBJ_DIR=$(pwd)/out" >> $GITHUB_ENV
        echo "ANYKERNEL_DIR=$(pwd)/anykernel" >> $GITHUB_ENV
        echo "TC_DIR=$(pwd)/tc" >> $GITHUB_ENV
        echo "CLANG_DIR=$(pwd)/tc" >> $GITHUB_ENV
        
        # ✅ إصلاح: تحديد حجم CCache (5GB مثالي لـ GitHub)
        echo "CCACHE_DIR=$(pwd)/.ccache" >> $GITHUB_ENV
        mkdir -p "$(pwd)/.ccache"
        ccache -M 5G  # ✅ هذا مهم!
        ccache -z     # ✅ مسح الإحصائيات القديمة
        
        # Display build info
        cores=$(nproc --all)
        os=$(lsb_release -d | cut -f2-)  # ✅ طريقة أفضل
        time=$(TZ="Asia/Kolkata" date "+%Y-%m-%d %H:%M:%S")
        commit_head=$(git log --oneline -1)
        
        echo "🚀 Build Triggered ⌛"
        echo "Kernel: ${{ env.KERNEL_NAME }}"
        echo "Support: ${{ env.KERNEL_SUPPORT }}"
        echo "Variant: ${{ env.KERNEL_VARIANT }}"
        echo "System: ${os}"
        echo "Cores: ${cores}"
        echo "Time (IST): ${time}"
        echo "Last Commit: ${commit_head}"
        echo "CCache: 5GB enabled"
        echo "Note: No swap needed (16GB RAM available)"
    
    - name: 🔧 Download Toolchain
      run: |
        if [ ! -d "${{ env.TC_DIR }}" ]; then
          echo "📥 Downloading ZyC-Clang 15.0.7..."
          wget -q "${{ env.CLANG_URL }}"
          mkdir -p "${{ env.TC_DIR }}"
          tar -xvf Clang-15.0.7-20260205.tar.gz -C "${{ env.TC_DIR }}"
          rm -rf Clang-15.0.7-20260205.tar.gz
          echo "✅ Toolchain downloaded and extracted"
        else
          echo "✅ Toolchain already exists"
        fi
        
        # Add toolchain to PATH
        echo "${{ env.CLANG_DIR }}/bin" >> $GITHUB_PATH
        
        # Verify clang version
        echo "🔧 Clang version:"
        ${{ env.CLANG_DIR }}/bin/clang --version | head -3
    
    - name: 🏗️ Build Kernel
      run: |
        START_TIME=$(date +"%s")
        
        # Clean previous builds
        rm -rf "${{ env.OBJ_DIR }}"
        mkdir -p "${{ env.OBJ_DIR }}"
        
        # Generate defconfig
        echo "########### Generating Defconfig ############"
        make -s ARCH="${{ env.ARCH }}" O="${{ env.OBJ_DIR }}" "${{ env.CONFIG_FILE }}" -j$(nproc --all)
        
        if [ $? -eq 0 ]; then
          echo "✅ Defconfig generated successfully"
        else
          echo "❌ Defconfig generation failed"
          exit 1
        fi
        
        # Compile kernel
        echo "######### Compiling kernel #########"
        make -j$(nproc --all) \
          O="${{ env.OBJ_DIR }}" \
          ARCH="${{ env.ARCH }}" \
          CC="ccache clang" \
          CLANG_TRIPLE="aarch64-linux-gnu-" \
          CROSS_COMPILE="aarch64-linux-gnu-" \
          CROSS_COMPILE_ARM32="arm-linux-gnueabi-" \
          LLVM=1 \
          LLVM_IAS=1 \
          2>&1 | tee error.log
        
        # Check if compilation succeeded
        COMPILED_IMAGE="${{ env.OBJ_DIR }}/arch/arm64/boot/Image.gz"
        COMPILED_DTBO="${{ env.OBJ_DIR }}/arch/arm64/boot/dtbo.img"
        
        if [[ -f "${COMPILED_IMAGE}" && -f "${COMPILED_DTBO}" ]]; then
          echo "🎉 Kernel compiled successfully ✅"
          END_TIME=$(date +"%s")
          DIFF=$((END_TIME - START_TIME))
          echo "⏱️  Compilation took: $((DIFF / 60)) minute(s) and $((DIFF % 60)) second(s)"
          
          # ✅ إظهار إحصائيات CCache
          echo ""
          echo "📊 CCache Statistics:"
          ccache -s
        else
          echo "❌ Compilation failed"
          echo "Check error.log for details"
          exit 1
        fi
    
    - name: 📦 Package Kernel
      run: |
        START_TIME=$(date +"%s")
        ZIMAGE="${{ env.OBJ_DIR }}/arch/arm64/boot/Image.gz"
        DTBO="${{ env.OBJ_DIR }}/arch/arm64/boot/dtbo.img"
        ZIP_NAME="${{ env.KERNEL_NAME }}-$(date +"%Y%m%d-%H%M").zip"  # ✅ تنسيق أفضل
        
        # Clone AnyKernel3
        rm -rf "${{ env.ANYKERNEL_DIR }}"
        git clone -q "${{ env.ANYKERNEL_REPO }}" -b "${{ env.ANYKERNEL_BRANCH }}" "${{ env.ANYKERNEL_DIR }}"
        
        # Copy kernel files
        cp -f "${ZIMAGE}" "${DTBO}" "${{ env.ANYKERNEL_DIR }}/"
        
        # Create zip
        cd "${{ env.ANYKERNEL_DIR }}"
        find . -name "*.zip" -type f -delete
        zip -r -9 AnyKernel.zip *
        mv AnyKernel.zip "${ZIP_NAME}"
        
        # Sign the zip
        echo "🔏 Signing build with AOSP keys"
        cd "${{ env.KERNEL_DIR }}"
        if [ ! -f zipsigner-3.0.jar ]; then
          wget -O zipsigner-3.0.jar "${{ env.ZIPSIGNER_URL }}"
        fi
        
        java -jar zipsigner-3.0.jar "${{ env.ANYKERNEL_DIR }}/${ZIP_NAME}" "${ZIP_NAME/.zip/-signed.zip}"
        SIGNED_ZIP="${ZIP_NAME/.zip/-signed.zip}"
        
        # Clean up
        rm -rf "${{ env.ANYKERNEL_DIR }}"
        
        END_TIME=$(date +"%s")
        DIFF=$((END_TIME - START_TIME))
        
        echo "############################################"
        echo "🚀 Build Complete"
        echo "############################################"
        echo "Total time: $((DIFF / 60))m $((DIFF % 60))s"
        echo "Toolchain: ZyC-Clang 15.0.7"
        echo "CCache: 5GB (active but not cached between runs)"
        echo "Build file: ${SIGNED_ZIP}"
        echo "############################################"
    
    - name: 📤 Upload Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: kernel-${{ env.KERNEL_NAME }}-$(date +'%Y%m%d-%H%M')
        path: |
          ${{ env.KERNEL_DIR }}/*.zip
          ${{ env.KERNEL_DIR }}/error.log
          ${{ env.OBJ_DIR }}/arch/arm64/boot/Image.gz
          ${{ env.OBJ_DIR }}/arch/arm64/boot/dtbo.img
        retention-days: 30
