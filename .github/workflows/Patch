name: 🛠️ Smart Patch with Reject Handling

on:
  workflow_dispatch:
    inputs:
      commit_url:
        description: 'GitHub commit URL'
        required: false
        default: 'https://github.com/sidex15/android_kernel_lge_sm8150/commit/849ca8ce954d9dbb082dcf83c98af861e98e5635'
  
  push:
    branches:
      - zyc2

jobs:
  pull-patch:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    steps:
    # 1. Checkout
    - name: 📦 Checkout zyc2
      uses: actions/checkout@v4
      with:
        ref: zyc2
        
    # 2. تطبيق الباتش مع حفظ الـ rejects
    - name: 🛠️ Apply Patch with Rejects
      id: apply_patch
      run: |
        echo "🔄 Applying patch with reject handling..."
        
        PATCH_URL="https://github.com/sidex15/android_kernel_lge_sm8150/commit/849ca8ce954d9dbb082dcf83c98af861e98e5635.patch"
        
        echo "📥 Downloading patch..."
        wget -q -O source.patch "$PATCH_URL"
        
        echo "🔧 Applying patch (allow rejects)..."
        git apply --reject source.patch 2>&1 | tee apply.log || true
        
        REJ_COUNT=$(find . -name "*.rej" 2>/dev/null | wc -l)
        APPLIED_COUNT=$(grep -c "Applied.*cleanly" apply.log || echo 0)
        
        echo "📊 Results:"
        echo "- Applied cleanly: $APPLIED_COUNT hunks"
        echo "- Rejected: $REJ_COUNT hunks"
        
        if [ "$REJ_COUNT" -gt 0 ]; then
          echo "HAS_REJECTS=true" >> $GITHUB_OUTPUT
        else
          echo "HAS_REJECTS=false" >> $GITHUB_OUTPUT
        fi
        echo "REJ_COUNT=$REJ_COUNT" >> $GITHUB_OUTPUT
        echo "APPLIED_COUNT=$APPLIED_COUNT" >> $GITHUB_OUTPUT
        
    # 3. إنشاء تقرير للـ rejects
    - name: 📝 Create Reject Report
      if: steps.apply_patch.outputs.HAS_REJECTS == 'true'
      run: |
        cat > REJECT_REPORT.md << EOF
        # Patch Reject Report
        **Commit:** 849ca8ce954d9dbb082dcf83c98af861e98e5635
        **Branch:** zyc2
        
        ## Summary
        - Applied: ${{ steps.apply_patch.outputs.APPLIED_COUNT }} hunks
        - Rejected: ${{ steps.apply_patch.outputs.REJ_COUNT }} hunks
        EOF
        find . -name "*.rej" -exec echo "- {}" >> REJECT_REPORT.md \;
        
    # 4. عمل commit للتغييرات الناجحة فقط
    - name: 💾 Commit Successful Changes
      id: commit_changes
      run: |
        if git diff --quiet && git diff --cached --quiet; then
          echo "HAS_SUCCESSFUL_CHANGES=false" >> $GITHUB_OUTPUT
          exit 0
        fi
        
        git reset HEAD *.rej 2>/dev/null || true
        git config user.name "GitHub Actions"
        git config user.email "actions@github.com"
        
        git add .
        git commit -m "Apply partial patch: 849ca8ce954d9dbb082dcf83c98af861e98e5635
        
        Applied: ${{ steps.apply_patch.outputs.APPLIED_COUNT }} hunks
        Rejected: ${{ steps.apply_patch.outputs.REJ_COUNT }} hunks"
        
        echo "HAS_SUCCESSFUL_CHANGES=true" >> $GITHUB_OUTPUT
        
    # 5. رفع التغييرات الناجحة
    - name: 📤 Push Successful Changes
      if: steps.commit_changes.outputs.HAS_SUCCESSFUL_CHANGES == 'true'
      run: |
        git push origin HEAD:zyc2
        
    # 6. حفظ الأرشيف
    - name: 📦 Save All Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: patch-849ca8c-results
        path: |
          source.patch
          apply.log
          *.rej
          REJECT_REPORT.md
