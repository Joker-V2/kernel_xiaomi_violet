name: 🛠️ Smart Patch with Reject Handling

on:
  workflow_dispatch:
    inputs:
      commit_url:
        description: 'GitHub commit URL'
        required: false
        default: 'https://github.com/sidex15/android_kernel_lge_sm8150/commit/4ba6dccf73a620e565803e5995d5748ecfbb56a2'
  
  push:
    branches:
      - zyc2

jobs:
  pull-patch:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    steps:
    # 1. Checkout
    - name: 📦 Checkout zyc2
      uses: actions/checkout@v4
      with:
        ref: zyc2
        
    # 2. تطبيق الباتش مع حفظ الـ rejects
    - name: 🛠️ Apply Patch with Rejects
      id: apply_patch
      run: |
        echo "🔄 Applying patch with reject handling..."
        
        PATCH_URL="https://github.com/sidex15/android_kernel_lge_sm8150/commit/4ba6dccf73a620e565803e5995d5748ecfbb56a2.patch"
        
        echo "📥 Downloading patch..."
        wget -q -O source.patch "$PATCH_URL"
        
        echo "🔧 Applying patch (allow rejects)..."
        git apply --reject source.patch 2>&1 | tee apply.log || true
        
        # حساب عدد الـ rejects بطريقة أكثر قوة
        REJ_COUNT=$(find . -name "*.rej" 2>/dev/null | wc -l)
        
        # حساب عدد hunks المطبقة بطريقة مختلفة
        APPLIED_COUNT=0
        if [ -s apply.log ]; then
          # محاولة قراءة التقرير من git apply
          if grep -q "Applied patch" apply.log; then
            APPLIED_COUNT=$(grep -o "Applied patch [0-9]*" apply.log | tail -1 | grep -o "[0-9]*" || echo 0)
          elif grep -q "hunks FAILED" apply.log; then
            TOTAL_HUNKS=$(grep -o "[0-9]* hunks" apply.log | head -1 | grep -o "[0-9]*")
            FAILED_HUNKS=$(grep -o "[0-9]* hunks FAILED" apply.log | grep -o "[0-9]*")
            if [ -n "$TOTAL_HUNKS" ] && [ -n "$FAILED_HUNKS" ]; then
              APPLIED_COUNT=$((TOTAL_HUNKS - FAILED_HUNKS))
            fi
          fi
        fi
        
        echo "📊 Results:"
        echo "- Applied cleanly: $APPLIED_COUNT hunks"
        echo "- Rejected: $REJ_COUNT hunks"
        
        if [ "$REJ_COUNT" -gt 0 ]; then
          echo "HAS_REJECTS=true" >> $GITHUB_OUTPUT
        else
          echo "HAS_REJECTS=false" >> $GITHUB_OUTPUT
        fi
        
        # تعيين قيم افتراضية آمنة
        echo "REJ_COUNT=$REJ_COUNT" >> $GITHUB_OUTPUT
        echo "APPLIED_COUNT=$APPLIED_COUNT" >> $GITHUB_OUTPUT
        
    # 3. إنشاء تقرير للـ rejects
    - name: 📝 Create Reject Report
      if: steps.apply_patch.outputs.HAS_REJECTS == 'true'
      run: |
        cat > REJECT_REPORT.md << EOF
        # Patch Reject Report
        **Commit:** 4ba6dccf73a620e565803e5995d5748ecfbb56a2
        **Branch:** zyc2
        
        ## Summary
        - Applied: ${{ steps.apply_patch.outputs.APPLIED_COUNT || 0 }} hunks
        - Rejected: ${{ steps.apply_patch.outputs.REJ_COUNT || 0 }} hunks
        
        ## Rejected Files:
        EOF
        
        find . -name "*.rej" -exec echo "- {}" >> REJECT_REPORT.md \;
        
        echo "" >> REJECT_REPORT.md
        echo "## Patch Apply Log:" >> REJECT_REPORT.md
        echo '```' >> REJECT_REPORT.md
        cat apply.log >> REJECT_REPORT.md 2>/dev/null || echo "No apply log available" >> REJECT_REPORT.md
        echo '```' >> REJECT_REPORT.md
        
    # 4. عمل commit للتغييرات الناجحة فقط
    - name: 💾 Commit Successful Changes
      id: commit_changes
      run: |
        # التحقق من وجود أي تغييرات
        if git diff --quiet && git diff --cached --quiet; then
          echo "HAS_SUCCESSFUL_CHANGES=false" >> $GITHUB_OUTPUT
          echo "🔄 No changes to commit"
          exit 0
        fi
        
        # إزالة ملفات .rej من staging
        if [ -n "$(find . -name "*.rej" 2>/dev/null)" ]; then
          git reset HEAD *.rej 2>/dev/null || true
        fi
        
        git config user.name "GitHub Actions"
        git config user.email "actions@github.com"
        
        # إضافة جميع الملفات ما عدا .rej
        git add -A
        git reset HEAD *.rej 2>/dev/null || true
        
        # عمل commit مع معلومات عن الباتش
        APPLIED=${{ steps.apply_patch.outputs.APPLIED_COUNT || 0 }}
        REJECTED=${{ steps.apply_patch.outputs.REJ_COUNT || 0 }}
        
        git commit -m "Apply patch: 4ba6dccf73a620e565803e5995d5748ecfbb56a2
        
        Applied: $APPLIED hunks
        Rejected: $REJECTED hunks"
        
        echo "HAS_SUCCESSFUL_CHANGES=true" >> $GITHUB_OUTPUT
        echo "✅ Successfully committed changes"
        
    # 5. رفع التغييرات الناجحة
    - name: 📤 Push Successful Changes
      if: steps.commit_changes.outputs.HAS_SUCCESSFUL_CHANGES == 'true'
      run: |
        git push origin HEAD:zyc2
        echo "✅ Changes pushed successfully"
        
    # 6. حفظ الأرشيف
    - name: 📦 Save All Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: patch-4ba6dcc-results
        path: |
          source.patch
          apply.log
          *.rej
          REJECT_REPORT.md
